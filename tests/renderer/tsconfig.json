{
  "extends": "../../tsconfig.web.json",
  "compilerOptions": {
    "baseUrl": "../../",
    "paths": {
      "@/*": ["src/renderer/src/*"],
      "@renderer/*": ["src/renderer/src/*"]
    },
    "types": ["vitest/globals", "@testing-library/jest-dom"]
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "../../src/renderer/src/**/*",
    "../../src/preload/*.d.ts"
  ]
}
